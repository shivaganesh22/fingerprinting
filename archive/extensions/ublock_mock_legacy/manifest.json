{
  "manifest_version": 3,
  "name": "uBlock Origin Mock",
  "version": "1.0.0",
  "description": "Research fallback MV3 extension for tracker blocking tests",
  "permissions": [
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}